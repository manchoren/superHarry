# superHarry - Environment-Specific Paths Configuration
# Copy this file to .env.paths and configure for your environment
# .env.paths is gitignored and contains deployment-specific paths

# VM and deployment paths
VM_ROOT=/path/to/vm/root
VM_DATA_DIR=/var/lib/superharry
VM_CONFIG_DIR=/etc/superharry

# Caddy configuration (development or production)
CADDY_CONFIG_DIR=.dev-vm/caddy-config
CADDY_DATA_DIR=.dev-vm/caddy-data
CADDY_TOOLS_DIR=.dev-vm/caddy-tools

# Database paths
DB_PATH=./db.sqlite3
MEMORY_DB_PATH=/var/lib/superharry/memory.db
BACKUP_DIR=/var/lib/superharry/backups

# Sandbox paths
SANDBOX_WORKSPACE_ROOT=/var/lib/superharry/workspaces
SANDBOX_CACHE_DIR=/var/cache/superharry/sandbox

# omniroute endpoint
OMNIROUTE_ENDPOINT=http://localhost:20128/v1
OMNIROUTE_DASHBOARD=http://localhost:20128

# Local model (Ollama via omniroute)
LOCAL_MODEL_ENDPOINT=http://localhost:11434
LOCAL_MODEL_NAME=qwen3.5:4b
