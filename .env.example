# The application does not automatically load this file; export development values explicitly.
# Development-only gateway credential; never put individual model-provider keys here.
# Production services use the protected systemd credential omniroute-api-key.
# Set only when configured; an empty value is invalid.
# OMNIROUTE_API_KEY=replace-with-development-gateway-key
OMNIROUTE_ENDPOINT=http://localhost:20128/v1
OMNIROUTE_EXTERNAL_MODEL=nous-ai/solar-mini-4
OMNIROUTE_LOCAL_MODEL=ollama/qwen3.5:4b

# Reserved dedicated mailbox identity for T214; not authentication or service activation.
SUPERHARRY_GMAIL_ACCOUNT=
