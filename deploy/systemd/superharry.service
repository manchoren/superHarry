[Unit]
Description=SuperHarry Django test VM service
Requires=superharry-migrate.service
After=network.target superharry-migrate.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=superharry
Group=superharry
UMask=0077
WorkingDirectory=/opt/superharry/app
Environment=DJANGO_SECRET_KEY_FILE=%d/django-secret
Environment=DJANGO_DEBUG=0
Environment=DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,superharry.local
Environment=SUPERHARRY_TOTP_KEY_VERSION=1
Environment=SUPERHARRY_DATABASE_PATH=/var/lib/superharry/db.sqlite3
Environment=SUPERHARRY_GEMINI_CHAT=0
Environment=SUPERHARRY_ENABLED_FREE_PROVIDERS=gemini,groq
Environment=SUPERHARRY_OPENROUTER_APPROXIMATE_QUOTA=0
Environment=SUPERHARRY_FREE_PROVIDER_ORDER=gemini,groq
LoadCredentialEncrypted=django-secret:/etc/credstore.encrypted/superharry-django-secret
LoadCredentialEncrypted=totp-aes256-key:/etc/credstore.encrypted/superharry-totp-aes256-key
StateDirectory=superharry
StateDirectoryMode=0750
RuntimeDirectory=superharry
RuntimeDirectoryMode=0750
ReadWritePaths=/var/lib/superharry
ExecStart=/opt/superharry/venv/bin/gunicorn --no-control-socket --bind 127.0.0.1:8443 --workers 2 --timeout 30 --graceful-timeout 20 --limit-request-line 4094 --certfile=/etc/superharry/tls/test-cert.pem --keyfile=/etc/superharry/tls/test-key.pem superharry.wsgi:application
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=4096
TasksMax=96
MemoryMax=2G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
